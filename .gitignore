# --- Project Specific Rules ---

# 1. Keep data/cleaned folder empty except for .gitignore/.gitkeep
data/**
!data/
!data/cleaned/
!data/cleaned/.gitignore
!data/cleaned/.gitkeep

# 2. notebooks folder: only files starting with 01-05
notebooks/**
!notebooks/
!notebooks/01*
!notebooks/02*
!notebooks/03*
!notebooks/04*
!notebooks/05*
!notebooks/*de.ipynb

# 3. report folder: empty except for .gitkeep
report/**
!report/
!report/.gitkeep

# 4. Sources folder: empty except for .gitkeep
Sources/**
!Sources/
!Sources/.gitkeep

# 5. scripts folder: exclude entirely
scripts/

# 6. Exclude root files (requested by user)
PROJECT_PLAN.md
PROJECT_REQUIREMENTS.md
requirements.txt
HauptProject.code-workspace
*.code-workspace


# Local history
.history/
